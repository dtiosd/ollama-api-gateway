## Normalize line endings so the stored content does not depend on each
## contributor's core.autocrlf setting (Git for Windows defaults to "true",
## which would otherwise commit CRLF into a mostly-LF repository).
* text=auto eol=lf

## Source and configuration
*.py      text eol=lf
*.pyi     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.ini     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.toml    text eol=lf
*.example text eol=lf
.env.example text eol=lf

## Shell scripts must stay LF -- CRLF breaks them on Linux/macOS.
*.sh      text eol=lf

## Windows helpers keep CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

## Binary assets: never rewrite bytes or attempt a text diff.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary

## Migrations are hand-reviewed, so keep them plain LF text as well.
alembic/versions/*.py text eol=lf
