# 配置模板：复制为 .env 后填写；本文件不参与运行
# PostgreSQL（请替换 password 与库名）
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/ollama_api_gateway

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# 数据库连接池（每个 Uvicorn worker）
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800

# Ollama 并发控制（每个 Uvicorn worker）
OLLAMA_GLOBAL_CONCURRENCY=4
OLLAMA_MODEL_CONCURRENCY=2
OLLAMA_QUEUE_TIMEOUT=30
OLLAMA_MODELS_CACHE_TTL=10

# 管理接口（/backend/api-keys）口令。留空则管理接口整体禁用。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# CORS 允许来源，逗号分隔；* 表示不限制（此时不携带凭证）
CORS_ALLOW_ORIGINS=*
